# Build artifacts and the asar scratch space.
node_modules/

# One-off scratch files: asar dumps and the single-use scanners written while
# reverse-engineering an interface. They are regenerable from the archive and
# must not travel with the package.
_probe/_*.js
_probe/agent-*.md
_probe/agent-*.d.ts

# Probes that talk to a running host leave request bodies and screenshots behind.
_probe/browser/.chrome-profile/
_probe/browser/shots/
_probe/shot-*.png
_probe/*-test.json
_probe/t-*.json

# The corpus caches are derived data, not source: they are this machine's own
# session transcripts, 10 MB of them, regenerated by the probe that reads them.
# Committing them would put one developer's private logs in the repository and
# make the repository the expensive half of a sweep that is meant to be cheap.
# The probe rebuilds them with `--cache`; a missing cache is a cold run, not an
# error.
_probe/struct-real-cache.json
_probe/struct-lines-cache.json

# Editor and OS noise.
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
