{
  "name": "dsh-rice-guard",
  "version": "0.3.0",
  "type": "module",
  "description": "Repeat-output guard for DSH: watches the live assistant stream (thinking and text), catches verbatim loops and counting loops that differ only by a number, raises a manual-dismiss alarm, and cancels the runaway turn.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "rice-guard",
    "loop",
    "loop-detection",
    "repetition",
    "repetition-detection",
    "degeneration",
    "watchdog",
    "runaway",
    "infinite-loop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoSHang05/dsh-rice-guard.git"
  },
  "homepage": "https://github.com/XiaoSHang05/dsh-rice-guard#readme",
  "bugs": {
    "url": "https://github.com/XiaoSHang05/dsh-rice-guard/issues"
  },
  "author": "XiaoSHang05",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./detect": "./src/detect.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CONTRACT.md",
    "VALIDATION.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs && node scripts/test.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dshWorkshop": {
    "permissions": []
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "jsdom": "^30.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0"
  }
}
